# Modelo da configuracao do contador de cadeira.
# Copie para %USERPROFILE%\barbearia-camera.env e preencha.
# O arquivo .env real NUNCA vai para o Git (contem a senha da camera).

# --- Camera IP (Xiongmai XM533, app iCSee/XMeye) ---
# O script monta rtsp://USUARIO:SENHA@CAM_HOST:554/onvif2
# ATENCAO: se a senha tiver @ : / ou #, ela quebra essa URL — troque a senha na camera
# ou ajuste o script para fazer URL-encode antes de montar o endereco.
CAM_HOST=<IP-DA-CAMERA-NA-REDE-LOCAL>
CAM_USER=
CAM_PASS=

# --- Supabase ---
# Estes dois sao publicos (ja vao no JavaScript do site), nao sao segredo.
SUPABASE_URL=https://rpkqluaxhqsxnewunhfm.supabase.co
SUPABASE_ANON_KEY=sb_publishable__DjSquVnGXP8VX4DdwlKAQ_QRPB2ph2

# Segredo, guardado no cofre do Supabase com o nome camera_ingest_secret.
# Para recuperar: painel do Supabase -> SQL Editor ->
#   select decrypted_secret from vault.decrypted_secrets where name = 'camera_ingest_secret';
CAMERA_INGEST_SECRET=

# Nome desta maquina nos registros.
DEVICE=barbearia-notebook
